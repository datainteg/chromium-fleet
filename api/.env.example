# ============================================================================
# chromium-fleet API environment template
# Copy this file to ".env" and replace placeholder secrets before production.
# ============================================================================

# ----------------------------------------------------------------------------
# Network / server
# ----------------------------------------------------------------------------
PORT=8787
# Keep 127.0.0.1 — never 0.0.0.0 in production. API is accessed through Nginx.
HOST=127.0.0.1

# ----------------------------------------------------------------------------
# Primary auth: username/password login → JWT + refresh token
# ----------------------------------------------------------------------------
AUTH_USERNAME=admin
# Use a strong password (16+ chars, mixed case, numbers, symbols)
AUTH_PASSWORD=change-this-password
# Generate with: openssl rand -base64 48
JWT_SECRET=change-this-jwt-secret
# Must differ from JWT_SECRET. Generate with: openssl rand -base64 48
REFRESH_TOKEN_SECRET=change-this-refresh-secret

# Token lifetimes (jsonwebtoken format: 5m, 15m, 1h, 7d)
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Optional token metadata for verification
JWT_ISSUER=chromium-fleet-api
JWT_AUDIENCE=chromium-fleet-clients

# ----------------------------------------------------------------------------
# Optional legacy API key mode (disabled by default — keep false)
# ----------------------------------------------------------------------------
ALLOW_API_KEY_AUTH=false
API_KEY=optional-legacy-key

# ----------------------------------------------------------------------------
# Auth controls
# ----------------------------------------------------------------------------
# Never set DISABLE_AUTH=true in production
DISABLE_AUTH=false

# ----------------------------------------------------------------------------
# Seller install / uninstall controls
# ----------------------------------------------------------------------------
# Default: false (safe). Seller creation/removal via the API is disabled.
#
# Recommended workflow:
#   - Provision sellers by running install.sh directly on the host VM.
#   - Remove sellers by running uninstall.sh directly on the host VM.
#   - Never enable ALLOW_INSTALL in Docker API mode (returns 501 anyway).
#
# Set ALLOW_INSTALL=true ONLY when intentionally allowing API-based provisioning
# from a trusted host-mode or systemd deployment.
ALLOW_INSTALL=false
ALLOW_UNINSTALL=false

# Lifecycle actions (start/stop/restart/status/proxy-rotate) — keep true
ALLOW_ACTIONS=true

# ----------------------------------------------------------------------------
# Destructive action controls
# ----------------------------------------------------------------------------
# Default: false (safe). Guards high-risk operations:
#   - DELETE /api/v1/sellers/:seller/extensions/:name
#   - POST   /api/v1/sellers/:seller/restore/:filename  (replaces profile)
#   - POST   /api/v1/sellers/actions/stop               (fleet-wide stop)
#   - POST   /api/v1/sellers/actions/recreate           (fleet-wide recreate)
#   - POST   /api/v1/sellers/actions/update             (fleet-wide image update)
#
# Set true only in controlled environments where these operations are needed.
# Normal operations (start, restart, status, proxy-rotate) are never blocked.
ALLOW_DESTRUCTIVE_ACTIONS=false

# ----------------------------------------------------------------------------
# Runtime controls
# ----------------------------------------------------------------------------
# Command timeout in milliseconds (900000 = 15 minutes)
COMMAND_TIMEOUT_MS=900000
# Root directory where seller folders exist (/opt/<seller>-browser)
SELLER_ROOT=/opt

# Fleet repo root — set automatically by docker-compose.fleet.yml (/fleet)
# Leave unset when running on host (auto-detected from __dirname)
# FLEET_ROOT=/fleet

# Monitoring cache TTL in milliseconds. Higher = less Docker polling.
MONITOR_CACHE_TTL_MS=4000

# SSE stream polling intervals
MONITOR_STREAM_DEFAULT_INTERVAL_MS=15000
MONITOR_STREAM_MIN_INTERVAL_MS=5000
MONITOR_STREAM_MAX_INTERVAL_MS=60000
MONITOR_STREAM_HEARTBEAT_MS=15000

# ----------------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------------
# Comma-separated frontend origins. Set to your actual domain(s) in production.
# Example: CORS_ORIGINS=https://dashboard.yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ----------------------------------------------------------------------------
# Rate limiting — auth endpoints (/api/v1/auth/*)
# ----------------------------------------------------------------------------
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20

# ----------------------------------------------------------------------------
# Rate limiting — all API endpoints (/api/*)
# ----------------------------------------------------------------------------
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=200

# ----------------------------------------------------------------------------
# SSE stream protection
# ----------------------------------------------------------------------------
# Max concurrent SSE streams per client IP
SSE_MAX_CONNECTIONS_PER_IP=3
# Max bytes per individual SSE event (default: 2MB)
SSE_MAX_EVENT_BYTES=2097152
# Max total bytes per SSE connection per hour before forced close (default: 100MB)
SSE_MAX_BYTES_PER_HOUR=104857600

# ----------------------------------------------------------------------------
# Persistent session store
# ----------------------------------------------------------------------------
# Refresh tokens persist here across API restarts. Must be on a writable path.
# In Docker mode this resolves to the /opt volume mount on the host.
SESSIONS_FILE=/opt/chromium-fleet-sessions.json

# ----------------------------------------------------------------------------
# Webhook crash alerts (optional)
# ----------------------------------------------------------------------------
# POST is sent when a seller container crashes or recovers.
# Discord: WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
# Slack:   WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
WEBHOOK_URL=

# ----------------------------------------------------------------------------
# Notes
# ----------------------------------------------------------------------------
# If API is routed through Nginx, requests are protected by:
#   1) Nginx basic auth (username/password via htpasswd)
#   2) API JWT auth (Authorization: Bearer <accessToken>)
