# ============================================================================
# chromium-fleet API environment template
# Copy this file to ".env" and replace placeholder secrets before production.
# ============================================================================

# ----------------------------------------------------------------------------
# Network / server
# ----------------------------------------------------------------------------
# API listen port
PORT=8787
# Bind address. Use 127.0.0.1 when behind Nginx (recommended).
# Use 0.0.0.0 only if you need direct external access to port 8787.
HOST=127.0.0.1

# ----------------------------------------------------------------------------
# Primary auth mode: username/password login -> JWT + refresh token
# ----------------------------------------------------------------------------
# Username used by POST /api/v1/auth/login
AUTH_USERNAME=admin
# Strong password for login endpoint (change this)
AUTH_PASSWORD=change-this-password
# Secret for access-token signing (minimum 32 random chars recommended)
JWT_SECRET=change-this-jwt-secret
# Secret for refresh-token signing (use a different value from JWT_SECRET)
REFRESH_TOKEN_SECRET=change-this-refresh-secret

# Token lifetimes (jsonwebtoken format: 15m, 1h, 7d, etc.)
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Optional token metadata used for verification
JWT_ISSUER=chromium-fleet-api
JWT_AUDIENCE=chromium-fleet-clients

# ----------------------------------------------------------------------------
# Optional legacy API key mode (disabled by default)
# ----------------------------------------------------------------------------
# Set true only if old clients still use x-api-key
ALLOW_API_KEY_AUTH=false
# Used only when ALLOW_API_KEY_AUTH=true
API_KEY=optional-legacy-key

# ----------------------------------------------------------------------------
# Safety controls
# ----------------------------------------------------------------------------
# Never set true in production unless intentionally exposing all API routes.
DISABLE_AUTH=false
# Allow API to create new sellers via install.sh
ALLOW_INSTALL=true
# Allow API to remove sellers via uninstall.sh
ALLOW_UNINSTALL=true
# Allow API lifecycle actions (start/stop/restart/update/etc.)
ALLOW_ACTIONS=true

# ----------------------------------------------------------------------------
# Runtime controls
# ----------------------------------------------------------------------------
# Command timeout in milliseconds (900000 = 15 minutes)
COMMAND_TIMEOUT_MS=900000
# Root directory where seller folders exist (/opt/<seller>-browser)
SELLER_ROOT=/opt

# Fleet repo root (override when running API in Docker — set by docker-compose.fleet.yml)
# Leave unset when running on host — auto-detected from __dirname.
# FLEET_ROOT=/fleet

# Monitoring cache TTL in milliseconds.
# Higher = less Docker polling, lower RAM/CPU usage on small VMs.
MONITOR_CACHE_TTL_MS=4000

# Live monitoring SSE stream controls.
# Default interval is used when client omits ?intervalMs.
MONITOR_STREAM_DEFAULT_INTERVAL_MS=15000
MONITOR_STREAM_MIN_INTERVAL_MS=5000
MONITOR_STREAM_MAX_INTERVAL_MS=60000
MONITOR_STREAM_HEARTBEAT_MS=15000

# ----------------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------------
# Comma-separated frontend origins allowed by browser CORS checks.
# Example for production:
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ----------------------------------------------------------------------------
# Auth rate limiting (applies to /api/v1/auth/* endpoints)
# ----------------------------------------------------------------------------
# Number of auth requests allowed per window (default: 20 per 15 minutes)
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=900000

# Persistent session store — survives API restarts, prevents users being
# logged out on every redeploy. Set to a writable path.
# In Docker mode this is on the /opt volume mount (persisted on host).
SESSIONS_FILE=/opt/chromium-fleet-sessions.json

# Webhook URL for crash alerts (optional).
# POST is sent when a seller container crashes or recovers.
# Compatible with Discord, Slack, and any HTTP endpoint.
#   Discord example:  WEBHOOK_URL=https://discord.com/api/webhooks/...
#   Slack example:    WEBHOOK_URL=https://hooks.slack.com/services/...
WEBHOOK_URL=

# If API is routed through default Nginx config, requests are protected by:
# 1) Nginx basic auth (username/password)
# 2) API JWT auth (Bearer access token)
