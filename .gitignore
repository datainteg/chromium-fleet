# Node.js
api/node_modules/
node_modules/

# Environment and secrets — never commit
api/.env
proxy.env
*.env
!.env.example
chromium-fleet-sessions.json

# Browser profile data — never commit (contains login sessions, cookies)
profile/
*/profile/

# Generated runtime directories
backups/
*/backups/
logs/
*/logs/

# Archive files
*.tar.gz
*.tar
*.zip

# SSL/TLS certificates (managed by certbot on host)
*.pem
*.key
*.crt
*.csr

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temp files
*.tmp
*.bak
*.swp
